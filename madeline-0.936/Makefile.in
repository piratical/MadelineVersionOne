VERSION = 0.936
PROGRAM_NAME = madeline
VERSION_NAME = $(PROGRAM_NAME)-$(VERSION)

srcdir = @srcdir@
top_srcdir = @top_srcdir@
VPATH = @srcdir@
prefix = @prefix@
exec_prefix = @exec_prefix@
bindir = @bindir@
sbindir = @sbindir@
libexecdir = @libexecdir@
datadir = @datadir@
sysconfdir = @sysconfdir@
sharedstatedir = @sharedstatedir@
localstatedir = @localstatedir@
libdir = @libdir@
infodir = @infodir@
mandir = @mandir@
includedir = @includedir@
oldincludedir = /usr/include

TAR = @TAR@
INSTALL = @INSTALL@
MAN_DIR = $(mandir)/man1
SHARE_DIR = $(datadir)/madeline


all: @MAKE_TARGETS@

madeline:
	cd src && $(MAKE) madeline

debug:
	cd src && $(MAKE) debug

install: installall
	

installall:
	cd src && $(MAKE) install
	$(INSTALL) -d $(MAN_DIR)
	$(INSTALL) -m 644 man/madeline.1 $(MAN_DIR)
	$(INSTALL) -d $(SHARE_DIR)
	$(INSTALL) -m 644 initialScript/initial.script.template $(SHARE_DIR)
	$(TAR) cf - documentation | (cd $(SHARE_DIR) && $(TAR) xf - )

clean:
	rm -f config.status config.cache config.log
	cd src; $(MAKE) clean

allclean: clean
	rm -f src/Makefile src/config.h

distribution: allclean
	$(TAR) czvf ../$(VERSION_NAME).tar.gz  -X exclude.list -C ../ $(VERSION_NAME)
	$(TAR) cIvf ../$(VERSION_NAME).tar.bz2 -X exclude.list -C ../ $(VERSION_NAME)
	###############################################################
	#                                                             #
	# Created ../$(VERSION_NAME) 
	# gzip and bzip2 tar files!                                   #
	#                                                             #
	###############################################################

