%%%%%%%%%%%%%%%
%
% Unit metrics:
%
%%%%%%%%%%%%%%%
/inch {72 mul}      bind def
/cm {inch 2.54 div} bind def
/mm {cm 10 div}     bind def


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% Standardized icon size definitions:
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/IconRadius 0.30 cm def
/IconDiameter IconRadius 2 mul      def
/IconDiagonal IconRadius 2 sqrt mul def
/CircumscribingRadius   IconRadius 1.3 mul def
/CircumscribingDiameter CircumscribingRadius 2 mul def
/TickLength 0.15 cm def
/VDrop1 -16.68 cm def
/VDrop2 -0.75 cm def
/VDrop2MinusIR VDrop2 IconRadius add def
/XUnit 1.50 cm def
/CellWidth XUnit 0.1 sub def


%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% Useful symbolic constants:
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/FEMALE         1      def
/MALE           0      def
/MISSING       -1      def
/UNKNOWNGENDER MISSING def
/VIRTUAL        0      def
/REAL           1      def
/PI      3.1415927     def


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% Symbolic constants for pregnancies
% not carried to term:
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/NONTERM        8        def
/NONTERMMALE    8        def
/NONTERMFEMALE  9        def
/NONTERMUNKNOWNGENDER 10 def


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% Border line styles/weights:
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/NOLINE      0      def
/THINLINE    1      def
/MEDIUMLINE  0.5 mm def
/THICKLINE   1.0 mm def


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% Shading Flags:
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/SHADE         true   def
/DONTSHADE     false  def

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% Text colors:
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/LIGHT 0.5 def
/VERYLIGHT 0.8 def
/Red { 1.0 0.0 0.0 setrgbcolor}  bind def
/LightRed {1.0 LIGHT LIGHT setrgbcolor} bind def
/VeryLightRed {1.0 VERYLIGHT VERYLIGHT setrgbcolor} bind def
/Green {0.0 1.0 0.0 setrgbcolor} bind def
/LightGreen {LIGHT 1.0 LIGHT setrgbcolor} bind def
/VeryLightGreen {VERYLIGHT 1.0 VERYLIGHT setrgbcolor} bind def
/Blue { 0.0 0.0 1.0 setrgbcolor} bind def
/LightBlue { VERYLIGHT VERYLIGHT 1.0 setrgbcolor} bind def
/VeryLightBlue { 0.93 0.93 1.0 setrgbcolor} bind def
/DarkRed { 0.7 0.0 0.0 setrgbcolor} bind def
/DarkestRed { 0.5 0.0 0.0 setrgbcolor} bind def
/Maroon { 0.8 0.0 0.4 setrgbcolor} bind def
/Orange { 1.0 0.6 0.2 setrgbcolor} bind def
/LightOrange { 1.0 0.8 0.6 setrgbcolor} bind def
/VeryLightOrange { 1.0 0.9 0.8 setrgbcolor} bind def
/Yellow { 0.85 0.8 0.0 setrgbcolor} bind def
/Gray1 { 0.95 setgray } bind def
/Gray2 { 0.90 setgray } bind def
/Gray3 { 0.85 setgray } bind def
/Gray4 { 0.80 setgray } bind def
/Gray5 { 0.75 setgray } bind def
/Gray6 { 0.70 setgray } bind def

/RED            (7) 0 get def
/GREEN          (8) 0 get def
/BLUE           (9) 0 get def
/ORANGE         (0) 0 get def

/LIGHTRED        (r) 0 get def
/VERYLIGHTRED    (R) 0 get def
/LIGHTGREEN      (g) 0 get def
/VERYLIGHTGREEN  (G) 0 get def
/LIGHTBLUE       (b) 0 get def
/VERYLIGHTBLUE   (B) 0 get def
/LIGHTORANGE     (o) 0 get def
/VERYLIGHTORANGE (O) 0 get def


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% Define dash lengths for wrapping icons:
%
% female icon: wrap with exactly 12 dashes,
% male icon  : wrap with exactly 16 dashes (4 per side):
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/FemaleDashLength IconRadius 2 mul PI mul 24 div def
/MaleDashLength   IconDiameter 8 div def 


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% Boolean toggle for color shading/printing:
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/INCOLOR true def
/REVERSE_SHADING false def
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% 
% Boolean toggle for showing crossover tags:
% 
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/CROSSOVERTAGS false def
/TAGSIZE 2.0 mm def


%%%%%%%%%%%%%%%%%
%
% Font Variables:
%
%%%%%%%%%%%%%%%%%
/IconFontSize 7 def
/CellFontSize  7 def
/LegendFontSize 9 def
/CellMargin 1.0 mm def
/IconFont {/Helvetica-Bold findfont} def
/CellFont {/Helvetica findfont} def
/BoldFont {/Helvetica-Bold findfont} def


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% Page margins and widths: used by MultiplePagePrint:
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/leftmargin   1.00 cm def
/bottommargin 1.00 cm def
/pagewidth    19.50 cm def
/pageheight   26.00 cm def


