#define LEGEND_FONT_SIZE 9

/* DEFAULT PEDIGREE DRAWING PARAMETERS                                             */
/* DO NOT CHANGE UNLESS YOU *REALLY* UNDERSTAND WHAT YOU ARE DOING !!!             */
/* NOTE THAT SOME MEASURES, SUCH AS VerticalDrop1, ARE MODIFIED DYNAMICALLY.       */
/* MEASUREMENTS ARE IN CENTIMETERS                                                 */
/*                                                                                 */
/* DRAWINGPARAMETERS:                                                              */
/*                                                                                 */
/*                                                                                 */
/*           |<-- HorizontalInterval --->|                                         */
/*           |                           |                                         */
/*        +-----+                      _____                                       */
/*        |     |                     /     \                                      */
/*        |  x  |---------+----------|   x   |                                     */
/*        |     |         |    ^      \     /                                      */
/*        +-----+         |    |       -----                                       */
/*                        | VerticalDrop1                                          */
/*        xxxxxxx         |    |      xxxxxxx                                      */
/*        xxxxxxx         |    |      xxxxxxx                                      */
/*        xxxxxxx         |    |      xxxxxxx                                      */
/*                        |    v                                                   */
/* ----------+------------+--------------+---------------------------+             */
/*           |       ^                   |                           |             */
/*           | VerticalDrop2             |                           |             */
/*         _____     |                +-----+                      _____           */
/*        /     \    v                |     |                     /     \          */
/*       |   x   |  ---               |  x  |                    |   x   |         */
/*        \     /                     |     |                     \     /          */
/*         -----                      +-----+                      -----           */
/*           |           |                                                         */
/*           |<---Half-->|      xxxxxxxxxxxxxxxxxxx                                */
/*           | HZInterval|      xxxxxxxxxxxxxxxxxxx                                */
/*           |           |      xxxxxxxxxxxxxxxxxxx                                */
/*                              |                 |                                */
/*                              |<-- CellWidth -->|                                */
/*                                                                                 */
/* UNITS ARE ALWAYS CENTIMETERS -- YOU CAN'T CHANGE THIS                           */
/*                                                                                 */
#define DP_ICON_DIAMETER 0.6 
#define DP_ICON_RADIUS   0.3  /* MUST BE HALF OF THE DIAMETER     */
#define DP_HZ_INTERVAL   1.5
#define DP_CELL_SPACING  0.1  /* SPACING between cell widths:     */
                              /* i.e., between successive text    */
                              /* columns.  CellWidth itself is    */
                              /* based on the horizontal interval */
#define DP_TICK_LENGTH   0.15 
#define DP_VT_DROP1     -3.0  /* MUST BE NEGATIVE                 */  
#define DP_VT_DROP2     -0.75 /* MUST BE NEGATIVE                 */

/* DEFAULT EVALUATION INTERVAL AND OFF END DISTANCE */
#define EVALUATION_INTERVAL 0.5
#define OFF_END_DISTANCE 10.0

/*                                                               */
/* MAXIMUM NUMBER OF KIDS AND SPOUSES                            */
/*                                                               */
/* NOTE BENE: The pedigree reconstruction code is NOT limited    */
/* by the defines below because vectors of children and spouses  */
/* are allocated and, as needed, re-allocated dynamically, so    */
/* there are NO LIMITS on the number of offspring or mates       */
/* modeled by the program.  The program thus uses memory in an   */
/* efficient  manner.  However, some other functions in the      */
/* program do have limitations where these #defines apply.       */
/* These are:                                                    */
/*                                                               */
/* (1) Sorting functions such as the functions called by the     */
/*     SORT command may use fixed-length vectors of pointers     */
/*     whose lengths are defined by MAXKIDS.                     */
/* (2) Aggregate-level function evaluation processing, such as   */
/*     functions for calculating the mean or standard deviation  */
/*     of a variable in a sibship also use fixed-length vectors  */
/*     whose lengths are defined by MAXKIDS to keep running      */
/*     sums and such.                                            */
/* (3) A part of the Mendelian inheritance checking routine in   */
/*     integrity.c uses a fixed-length vector of pointers to     */
/*     individuals to sort homozygotes at the front of a         */
/*     traversal list. Again, MAXKIDS defines the vector length. */
/*                                                               */
/* --> In cases where MAXKIDS is used, it limits the total       */
/*     number of offspring borne by a single mother which can be */
/*     processed. MAXKIDS=35 is certainly close to the           */
/*     theoretical maximum number that a human mother could bear */
/*     during 26 continuous years of pregnancy from adolescence  */
/*     through menopause.  Ugghhh, poor woman!  In any case,     */
/*     MAXKIDS has no effect on the number of children sired by  */
/*     a man which can be processed.                             */
/*                                                               */
#define MAXKIDS 35
#define MAXSPOUSES 10

/*                                                   */
/* COLORS: Defaults presented as decimal RGB triplet */
/*         parameters for the Postscript             */
/*         "setrgbcolor" command.                    */
/*                                                   */
#define COLOR_BLACK  "0 0 0"
#define COLOR_BLUE   "0 0 1"
#define COLOR_BROWN  "0.61 0.40 0.19"
#define COLOR_CYAN   "0 1 1"
#define COLOR_DKGRY  "0.3 0.3 0.3"
#define COLOR_FRGRN  "0.0 0.68 0.0"
#define COLOR_GRAY   "0.7 0.7 0.7"
#define COLOR_GREEN  "0 1 0"
#define COLOR_LTGRY  "0.9 0.9 0.9"
#define COLOR_MAGEN  "1 0 1"
#define COLOR_ORANG  "1.0 0.75 0.0"
#define COLOR_PEACH  "1.0 0.8 0.6"
#define COLOR_PURPL  "0.6 0.4 0.8"
#define COLOR_RED    "1 0 0"
#define COLOR_WHITE  "1 1 1"
#define COLOR_YELLW  "1 1 0"
 
