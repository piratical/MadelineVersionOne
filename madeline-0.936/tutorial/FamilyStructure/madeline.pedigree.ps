%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% Box: Prints a rectangular region in color
% 
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/Box {
 /ColorCode exch def
 /dy exch def
 /dx exch def
 /LeftTopY exch def
 /LeftTopX exch def
 gsave
 newpath
 LeftTopX LeftTopY moveto
 dx 0 rlineto
 0 dy neg rlineto
 dx neg 0 rlineto
 closepath
 INCOLOR
 {
  ColorCode RED             eq {Red            }if
  ColorCode LIGHTRED        eq {LightRed       }if
  ColorCode VERYLIGHTRED    eq {VeryLightRed   }if
  ColorCode GREEN           eq {Green          }if
  ColorCode LIGHTGREEN      eq {LightGreen     }if
  ColorCode VERYLIGHTGREEN  eq {VeryLightGreen }if
  ColorCode BLUE            eq {Blue           }if
  ColorCode LIGHTBLUE       eq {LightBlue      }if
  ColorCode VERYLIGHTBLUE   eq {VeryLightBlue  }if
  ColorCode ORANGE          eq {Orange         }if
  ColorCode LIGHTORANGE     eq {LightOrange    }if
  ColorCode VERYLIGHTORANGE eq {VeryLightOrange}if
  
 }
 {
  ColorCode RED             eq {Gray3}if
  ColorCode LIGHTRED        eq {Gray2}if
  ColorCode VERYLIGHTRED    eq {Gray1}if
  ColorCode GREEN           eq {Gray6}if
  ColorCode LIGHTGREEN      eq {Gray5}if
  ColorCode VERYLIGHTGREEN  eq {Gray4}if
  ColorCode BLUE            eq {Gray3}if
  ColorCode LIGHTBLUE       eq {Gray2}if
  ColorCode VERYLIGHTBLUE   eq {Gray1}if
  ColorCode ORANGE          eq {Gray6}if
  ColorCode LIGHTORANGE     eq {Gray5}if
  ColorCode VERYLIGHTORANGE eq {Gray4}if
 }ifelse
 fill
 grestore
} bind def
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% HaploHighlight: Processes color background highlighting
% for haplotype displays
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/HaploHighlight
{
 /Color2 exch def
 /Color1 exch def
 /LineHeight exch def
 /CellWidth exch def
 /y exch def
 /x exch def
 /HalfWidth CellWidth 2 div def
 x y HalfWidth LineHeight Color1 Box
 x HalfWidth add y HalfWidth LineHeight Color2 Box
} bind def
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% TrianglePoint: Prints a little triangular point
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/TrianglePoint{
 /rotation exch def
 /size exch def
 /y exch def
 /x exch def
 gsave
 /HalfSize size 2 div def
 /ThreeFourthsSize size 3 mul 4 div def
 x y translate
 rotation rotate
 newpath
 0 HalfSize neg moveto
 ThreeFourthsSize HalfSize rlineto
 ThreeFourthsSize neg HalfSize rlineto
 closepath
 0 setgray fill
 grestore
} bind def
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% PointTag: Prints little numerical/letter tags
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/PointTag{
 /label exch def
 /rotation exch def
 /size exch def
 /y exch def
 /x exch def
 gsave
 /HalfSize size 2 div def
 /OneFourthSize HalfSize 2 div def
 /ThreeEighthsSize size 3 mul 8 div def
 /ThreeFourthsSize OneFourthSize 3 mul def
 /FontSize size 0.9 mul def
 x y translate
 rotation rotate
 0 HalfSize sub 0 HalfSize add moveto
 size 0 rlineto
 0 ThreeFourthsSize neg rlineto
 HalfSize neg ThreeEighthsSize neg rlineto
 HalfSize neg ThreeEighthsSize rlineto
 closepath
 clip
 gsave
 1 setgray fill
 grestore
 size 0.06 mul setlinewidth
 stroke
 rotation neg rotate
 CellFont [FontSize 0 0 FontSize 0 0] makefont setfont
 label stringwidth pop 2 div neg FontSize 3 div neg moveto
 label show
 grestore
}bind def
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% MissingSymbol: Draws the missing symbol indicator.
% This is currently a small dot
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/MissingSymbol
{/yms exch def
 /xms exch def
  gsave
  newpath
  0 setgray
  xms yms 0.25 mm 0 360 arc fill
  grestore
}bind def
%%%%%%%%%%%
%
% Deceased:
%
%%%%%%%%%%%
/Deceased
{/yorg exch def
 /xorg exch def
 gsave
 newpath
 THINLINE setlinewidth
 xorg CircumscribingRadius add yorg CircumscribingRadius add moveto
 CircumscribingDiameter neg dup rlineto
 stroke
 grestore
}bind def
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% Bridge: Stroke the current path
% with a line that appears to bridge
% over other lines by virtue of having
% a white border:
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/Bridge
{
 gsave
 gsave
 /originalwidth currentlinewidth def
 originalwidth 3 mul setlinewidth
 1 setgray
 stroke
 grestore
 originalwidth setlinewidth
 0 setgray
 stroke
 grestore
}bind def
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% DoubleBridge: Stroke the current path
% with a double line that appears to bridge
% over other lines by virtue of being edged
% in white:
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/DoubleBridge
{
 gsave
 gsave
 gsave
 /originalwidth currentlinewidth def
 originalwidth 5 mul setlinewidth
 1 setgray
 stroke
 grestore
 originalwidth 3 mul setlinewidth
 0 setgray
 stroke
 grestore
 originalwidth setlinewidth
 1 setgray
 stroke
 grestore
}bind def
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% ClipToPrintablePage: used by MultiplePagePrint
% for clipping to the printable portion of a page
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/ClipToPrintablePage
{
 newpath
 leftmargin bottommargin moveto
 0 pageheight rlineto
 pagewidth 0 rlineto
 0 pageheight neg rlineto
 closepath
 clip
}bind def
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% MultiplePagePrint:
% Prints a large image defined by BigPictureProc on
% multiple pages arranged as n row-pages by m column-pages
% Note that BigPictureProc should start with gsave and end
% with a grestore in order for MultiplePagePrint to work
% properly:
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/MultiplePagePrint
{/rows                exch def
 /columns             exch def
 /BigPictureProcedure exch def
 gsave

 leftmargin bottommargin translate

 %
 % Loop through page rows and columns:
 %
 0 1 rows 1 sub
 {/rowcount exch def
  0 1 columns 1 sub
  {/columncount exch def

   gsave

   %
   % translate to window the printable region of this page:
   %
   pagewidth columncount mul neg
   pageheight rowcount mul neg
   translate

   %
   % do the big picture procedure:
   %

   %%page rows columns
   BigPictureProcedure

   %
   % gsave-grestore bracket showpage in order to preserve
   % the clipping region:
   %
   gsave showpage grestore

   grestore

  }for
 }for
 grestore
}bind def
%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% generic arrow procedure:
%
%%%%%%%%%%%%%%%%%%%%%%%%%%
/arrow
{
 /TailWidth  exch def
 /TailLength exch def
 /HeadWidth  exch def
 /HeadLength exch def
 /ArrowAngle exch def
 /ytip       exch def
 /xtip       exch def

 /HalfHeadWidth HeadWidth 2 div def
 /HalfTailWidth TailWidth 2 div def
 /TailIndent    HalfTailWidth HeadLength mul HalfHeadWidth div def

 /mtrx matrix def
 /SavedMatrix mtrx currentmatrix def
 xtip ytip translate
 ArrowAngle rotate
 0 0 moveto
 %
 % top half outline of arrow from tip to tail indent:
 %
 HeadLength HalfHeadWidth rlineto
 0 HalfHeadWidth HalfTailWidth sub neg rlineto
 TailLength 0 rlineto
 TailIndent neg HalfTailWidth neg rlineto
 %
 % bottom half outline from tail indent back to tip:
 %
 TailIndent HalfTailWidth neg rlineto
 TailLength neg 0 rlineto
 0 HalfHeadWidth HalfTailWidth sub neg rlineto
 closepath
 SavedMatrix setmatrix
}bind def
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% Proband Arrow: draws an arrow pointing to the proband
% pass the __icon's__ x and y center coordinates (this
% makes it really easy):
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/ProbandArrow
{
 /yiconorg exch def
 /xiconorg exch def
 /OffsetDistance IconRadius 1.15 mul def
 gsave
 newpath
 xiconorg OffsetDistance sub yiconorg OffsetDistance sub 225 3.5 mm 4 mm 3.5 mm 1.3 mm arrow
 fill
 grestore
}bind def
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% IconCell: Prints an icon cell.  A "cell" is a rectangular
% region with one or more lines of text labels on it.  An
% icon cell uses a fixed set of very specific and limited
% formatting conventions:
%
% Special flags for printing of genotypes and haplotypes:
% -------------------------------------------------------
%
% - All flags are embedded in the strings that are passed
%   to the routine.
% - Flags precede the printable portion of the strings and
%   are demarcated by special characters:
%
% (141/142)    : Genotype without special printing specs.
% (23`141/142) : Background colors 2 and 3 specified. Color
%                "2" prints behind "141" and color "3"
%                prints behind "142".
% (20^141/142) : A point tag prints with the label "2"
%                for the maternal crossover.
% (01^23`9\\10): A point tag prints with the label "1"
%                for the paternal crossover.  Background
%                colors are also specified.
% (R~121/124)  : The genotype prints in RED to indicate
%                a Mendelian inheritance error.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/IconCell
{
 /ArrayOfStrings   exch def
 /ShadeFlag        exch def
 /BorderType       exch def
 /CellWidth        exch def
 /Celly            exch def
 /Cellx            exch def

 %
 % get number of lines in cell:
 %
 /CellLines ArrayOfStrings length def
 /LineHeight CellFontSize 1.1 mul def
 /LineAdjust LineHeight 5 div def
 /CellHeight CellLines LineHeight mul CellMargin 2 mul add CellFontSize 2 div add def
 /HalfCellWidth CellWidth 2 div def

 %
 % Cellx and Celly specify the center point
 % of the top horizontal boundary of the cell box.
 % Define cell bounding box, clip to this:
 %
 gsave
 Cellx HalfCellWidth sub Celly moveto
 CellWidth 0 rlineto
 0 CellHeight neg rlineto
 CellWidth neg 0 rlineto
 closepath
 clip

 %
 % shade if more than five lines of text, but only if flag set:
 %
 ShadeFlag
 {
  CellLines 5 gt
  {
   gsave
   /currx Cellx HalfCellWidth sub def
   /curry Celly CellMargin sub LineAdjust sub def
   /dy    LineHeight 5 mul def
   INCOLOR
   {
    VeryLightBlue
   }
   {
    0.90 setgray
   }ifelse
   5 10 CellLines
   {
    /yadvance exch def
    newpath
    currx curry yadvance LineHeight mul neg add moveto
    CellWidth 0 rlineto
    /remaining CellLines yadvance sub def
    remaining 5 lt
    {
     /dy LineHeight remaining mul def
    }if
    0 dy neg rlineto
    CellWidth neg 0 rlineto
    closepath
    fill
   }for
   grestore
  }if
 }if

 %
 % move down CellFontSize plus CellMargin to start:
 %
 /Celly Celly CellFontSize CellMargin add sub def
 Cellx Celly moveto

 %
 % set font:
 %
 CellFont CellFontSize scalefont setfont

 %
 % Print text lines from array:
 %
 ArrayOfStrings
 {
  /ThisText exch def

  gsave
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  % Check for Labeled PointTags for haplotype displays:
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  ThisText (^) search
  {
   /Pre exch def
   /Match exch def
   /ThisText exch def
   % Get the two label codes (one or the other could be zero):
   /PointTagLabel1 Pre 0 1 getinterval def
   /PointTagLabel2 Pre 1 1 getinterval def
  }
  {
   /PointTagLabel1 (0) def
   /PointTagLabel2 (0) def
  }ifelse
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  % Check for background color tags for haplotype displays:
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  ThisText (`) search
  {
   % Define Has (Crossover) Tags:
   /Pre exch def
   /Match exch def
   /ThisText exch def
   % Get the two highlight color codes:
   /Color1 Pre 0 get def
   /Color2 Pre 1 get def
    %INCOLOR
    true
    {
     % Print the background colors:
     Cellx HalfCellWidth sub Celly LineHeight add LineAdjust sub CellWidth LineHeight Color1 Color2 HaploHighlight
    }if
  }if
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  % Check whether the string is flagged for printing in
  % a different color for Mendelian error notification:
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  ThisText (~) search
  {
    %
    % The Pre string contains the directives, if any, for
    % coloring the text:
    %
    /Pre exch def
    /Match exch def
    /ThisText exch def
    % Make font bold:
    BoldFont CellFontSize scalefont setfont
    % Search for directives in the Pre element:
    INCOLOR
    {
     Pre (R) search {Red       }if
     Pre (4) search {Red       }if
     Pre (3) search {Maroon    }if
     Pre (2) search {Orange    }if
     Pre (O) search {Orange    }if
     Pre (Y) search {Yellow    }if
     Pre (B) search {Blue      }if
     Pre (G) search {Green     }if
    }if
  }if
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  % Print crossover lines for haplotype display ?
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  CROSSOVERTAGS
  {
   gsave
   newpath
   0.15 mm setlinewidth
   % Maternal Crossover: just be sure it's not a date
   ThisText (/) search
   {
    pop search not
    {
     Cellx HalfCellWidth sub Celly LineHeight add LineAdjust sub moveto
     HalfCellWidth 0.5 mm sub 0 rlineto
     stroke
     % Print the PointTag Label only if its not zero:
     PointTagLabel1 (0) ne
     {
      Cellx HalfCellWidth sub TAGSIZE 2 div add Celly LineHeight add LineAdjust sub TAGSIZE 0 PointTagLabel1 PointTag
     }
     {
      Cellx HalfCellWidth sub Celly LineHeight add LineAdjust sub 1 mm 0 TrianglePoint
     }ifelse
    }if
   }if
   % Paternal Crossover
   ThisText (\\) search
   {
    Cellx 0.5 mm add Celly LineHeight add LineAdjust sub moveto
    HalfCellWidth 0.5 mm sub 0 rlineto
    stroke
    PointTagLabel2 (0) ne
    {
     Cellx HalfCellWidth add TAGSIZE 2 div sub Celly LineHeight add LineAdjust sub TAGSIZE 0 PointTagLabel2 PointTag
    }
    {
     Cellx HalfCellWidth add Celly LineHeight add LineAdjust sub 1 mm 180 TrianglePoint
    }ifelse
   }if
   % Both Maternal and Paternal Crossovers
   ThisText (+) search
   {
    Cellx HalfCellWidth sub Celly LineHeight add LineAdjust sub moveto
    HalfCellWidth 0.5 mm sub 0 rlineto
    Cellx 0.5 mm add Celly LineHeight add LineAdjust sub moveto
    HalfCellWidth 0.5 mm sub 0 rlineto
    stroke
    PointTagLabel1 (0) ne
    {
     Cellx HalfCellWidth sub TAGSIZE 2 div add Celly LineHeight add LineAdjust sub TAGSIZE 0 PointTagLabel1 PointTag
    }
    {
     Cellx HalfCellWidth sub Celly LineHeight add LineAdjust sub 1 mm 0 TrianglePoint
    }ifelse
    PointTagLabel2 (0) ne
    {
     Cellx HalfCellWidth add TAGSIZE 2 div sub Celly LineHeight add LineAdjust sub TAGSIZE 0 PointTagLabel2 PointTag
    }
    {
     Cellx HalfCellWidth add Celly LineHeight add LineAdjust sub 1 mm 180 TrianglePoint
    }ifelse
   }if
   grestore
  }if


  %
  % calculate where to print string centered horizontally:
  %
  /StringWidth ThisText stringwidth pop def
  %
  % Squish the fontsize down if string is too wide to print:
  %
  /WidthRatio CellWidth CellMargin 2 mul sub StringWidth div def
  WidthRatio 1.0 lt
  {
   %
   % case where string does not fit:
   % scale the width down to fit while maintaining the original height
   %
   CellFont [CellFontSize WidthRatio mul 0 0 CellFontSize 0 0] makefont setfont
   Cellx ThisText stringwidth pop 2 div sub Celly moveto
   ThisText show
  }
  {
   % case where string fits:
   Cellx StringWidth 2 div sub Celly moveto
   ThisText show
  }ifelse
  grestore
  %
  % increment y for next round:
  %
  /Celly Celly LineHeight sub def
 }forall

 %
 % Draw bounding border if not NOLINE:
 %
 BorderType NOLINE ne
 {
  gsave
  BorderType setlinewidth
  stroke
  grestore
 }if
 grestore
}bind def
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% FillRegion: Fills region with color (if INCOLOR)
% or with a shade of gray (if not INCOLOR).  Pushes GrayLevel
% onto the stack at the end of the procedure
% 
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/FillRegion
{
 /BluC exch def
 /GrnC exch def
 /RedC exch def
 /GrayLevel exch def
 
 gsave
 INCOLOR
 {
  %
  % In color case:
  %
  RedC GrnC BluC setrgbcolor
 }
 {
  REVERSE_SHADING
  {
   1.0 GrayLevel sub setgray
  }
  {
   GrayLevel setgray
  }ifelse % if REVERSE_SHADING
 }ifelse % if INCOLOR
 fill
 grestore
}bind def
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% ShowRegionText: changes ink color in black-and-white mode
% before showing the text based on background GrayLevel.  In
% color mode, text is just shown in black.
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/ShowRegionText
{
 /ThisText  exch def
 /GrayLevel exch def

 %
 % Text label is always printed in black ink if INCOLOR. However,
 % for black-and-white, it depends on how dark the gray fill is:
 % for dark fills, print text in white:
 %
 INCOLOR
 {
  ThisText show
 }
 {
  gsave                            % gsave because of possible ink color change
  REVERSE_SHADING { /GrayLevel 1.0 GrayLevel sub def } if % reverse
  GrayLevel 0.5 lt {1 setgray} if  % set letter color to white if on dark ground
  ThisText show
  grestore                         % restored
 }ifelse
}bind def
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% DrawPieSlice: Draws one slice of a "pie":
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/DrawPieSlice
{
 /DataArray exch def
 /endangle exch def
 /sttangle exch def
 /radius exch def
 /yorg exch def
 /xorg exch def

 gsave
 newpath
 % set to fairly thin lines:
 1 setlinewidth

 % draw arc and clip to it:
 xorg yorg moveto
 xorg yorg radius sttangle endangle arc
 closepath
 clip

 % set miter limit for acute angle line joins:
 1.415 setmiterlimit

 % Pull data elements from array:
 DataArray aload pop
 /BluC exch def
 /GrnC exch def
 /RedC exch def
 /GryC exch def
 /ThisText    exch def

 GryC RedC GrnC BluC FillRegion

 % print text in middle of pie slice:
 /HalfRadius IconRadius 2 div def
 /MiddleAngle endangle sttangle add 2 div def
 gsave                       % save unrotated coordinates and graphics
 xorg yorg translate         % translate to pie center
 MiddleAngle rotate          % rotate to middle of slice
 HalfRadius 1.1 mul 0 translate  % translate along x-axis half the radius (plus a little more)
 0 0 transform               % push coord. of origin in device space onto stack
 grestore                    % restore unrotated coord. system
 itransform                  % inverse transform the two coord. on the stack
 /tcy exch def /tcx exch def % transformed coordinates defined
 tcx tcy moveto

 %
 % Special handling to indicate MISSING:
 %
 ThisText (.) eq ThisText () eq or
 {%
  % A centered small dot represents MISSING:
  %
  TotalLevels MISSING ne { tcx tcy MissingSymbol } if
 }
 {%
  % center the text on the point: The positioning is more or less
  % optimized for placing capital letters:
  %
  ThisText stringwidth pop 2 div neg IconFontSize 3 div neg rmoveto
  %
  % ShowRegionText adjusts ink color based on GrayLevel when in
  % black-and-white mode:
  %
  GrayLevel ThisText ShowRegionText
 }ifelse % end if ThisText (.) eq

 0.5 setlinewidth                 % use a very thin line
 stroke                           % outline the closed arc

 grestore
}bind def
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% IncrementAngle procedure: used by /icon:
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/IncrementAngle
{/sttangle endangle def
 /endangle sttangle incrangle add def
}bind def
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% icon procedure.  This procedure produces the icon as either
% a square for males, a circle for females, or rectangle for unknown
% gender.  The icon may be divided into one or more "pie slices", with
% each slice representing a categorical variable.  Each slice may be
% colored (or shaded gray) to represent the level of the categorical
% variable, and a short text label optionally printed in the middle
% of the slice:
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/icon
{/ArrayOfArrays exch def
 /gender        exch def
 /icontype      exch def
 /yorigin       exch def
 /xorigin       exch def

 % Into how many pie slices is the icon divided?
 /slices ArrayOfArrays length def

 % Define angles and increments:
 /incrangle 360 slices div def
 /sttangle 90 def
 /endangle sttangle incrangle add def

 %save graphic state:
 gsave

 %
 % Set font for icon:
 %
 IconFont IconFontSize scalefont setfont

 newpath

 % If male, set radius to IconDiagonal, and clip to a square
 % else if female, set radius to IconRadius (plus a little extra), clip to circle
 % else if unknown, set radius to IconRadius, clip to a diamond

 gender NONTERM ge
 {%
  % Pregnancy not carried to term cases:
  %

  %
  % print non-term gender in small letters
  % below symbol:
  %
  IconFont IconFontSize scalefont setfont
  xorigin yorigin IconRadius sub moveto
  gender NONTERMMALE eq
  {% non-term male:
   (male)
  }
  {
   gender NONTERMFEMALE eq
   {% non-term female:
    (female)
   }
   {% non-term gender unknown:
    (unknown)
   }ifelse  % end if non-term female
  }ifelse   % end if non-term male
  dup stringwidth pop 2 div neg 0 rmoveto
  show

  /CircleRadius IconRadius def
  % clip to small triangle:
  xorigin IconRadius sub yorigin moveto
  IconRadius dup rlineto
  IconRadius dup neg rlineto
  closepath
  clip
 }
 {%
  % Normal gender cases:
  %
  gender UNKNOWNGENDER eq
  {
   % unknown gender:
   /CircleRadius IconRadius def
   % clip to diamond:
   xorigin IconRadius sub yorigin moveto
   IconRadius dup rlineto
   IconRadius dup neg rlineto
   IconRadius neg dup rlineto
   closepath
   clip
  }
  {

   % male or female:
   gender MALE eq
   {% male gender
    /CircleRadius IconDiagonal def
    % clip to a square:
    xorigin IconRadius sub yorigin IconRadius sub moveto
    0 IconDiameter rlineto
    IconDiameter 0 rlineto
    0 IconDiameter neg rlineto
    closepath
    clip
   }
   {% female gender
    /CircleRadius IconRadius 0.5 mm add def
    xorigin yorigin IconRadius 0 360 arc
    %
    % clipping is needed in case where only one slice
    % where DrawPieSlice is not called:
    %
    clip
   }ifelse              % end if gender male
  }ifelse               % end if gender unknown
 }ifelse                % end if non-term
 %
 % Process data in array of arrays - but only if
 % array length is greater than 1.  If array length is 1,
 % then there is only one categorical variable, so don't call
 % /DrawPieSlice at all in that case:
 %
 slices 1 eq
 {
  %
  % process case where there is only one slice:
  %
  ArrayOfArrays 0 get   % get the single array nested in ArrayOfArrays
  aload pop             % put the elements of that array on the stack
  /BluC exch def
  /GrnC exch def
  /RedC exch def
  /GrayLevel exch def
  /ThisText    exch def % text label for this level (can be null string)

  GrayLevel RedC GrnC BluC FillRegion

  %
  % Special handling to indicate MISSING:
  %
  ThisText (.) eq ThisText () eq or
  {%
   % A centered small dot represents MISSING:
   %
   TotalLevels MISSING ne { xorigin yorigin MissingSymbol } if
  }
  {
   % print the text label:
   xorigin yorigin moveto
   ThisText stringwidth pop 2 div neg IconFontSize 3 div neg rmoveto
   %
   % ShowRegionText adjusts ink color based on GrayLevel when in
   % black-and-white mode:
   %
   GrayLevel ThisText ShowRegionText
  }ifelse  % end if ThisText (.) eq
 }
 {
  %
  % process case where there are multiple slices:
  %
  ArrayOfArrays
  {
   /SliceArray exch def
   xorigin yorigin CircleRadius sttangle endangle SliceArray DrawPieSlice
   IncrementAngle
  }forall
 }ifelse
 %
 % if VIRTUAL, stroke clip path with a dashed line instead of a black line:
 %
 icontype VIRTUAL eq
 {
  gender FEMALE eq
  {%
   % case of FEMALE: wrap circle with exactly 12 dashes:
   %
   /DashLength FemaleDashLength def
  }
  {%
   % case of MALE: 4 black dashes per side = 16 total
   %
   /DashLength MaleDashLength def
  }ifelse
  %
  % The offset of a half DashLength makes the dashes
  % wrap the corners of the squares and centers the
  % the dashes over the cardinal directions on the circles:
  %
  [DashLength DashLength] DashLength 2 div setdash
 } if
 stroke

 grestore
}bind def
%%%%%%%%%%%%%%%%%%%%%%%%
%
% DisplayLegendVariable
%
%%%%%%%%%%%%%%%%%%%%%%%%
/DisplayLegendVariable{
 /ArrayOfArrays exch def
 /TotalLevels exch def
 /TextHeading exch def
 /cy exch def
 /cx exch def

 gsave
 IconFont IconFontSize scalefont setfont
 /curry cy 2 mm sub def
 cx TextHeading stringwidth pop 2 div sub curry moveto
 TextHeading show
 /curry curry 0.7 mm sub def
 /currx cx 1.5 cm sub def
 newpath
 currx curry moveto
 3.0 cm 0 rlineto
 0.5 setlinewidth
 stroke
 /curry curry 2.3 mm sub def
 /currx currx 3 mm add def
 ArrayOfArrays
 {
  /ThisArray exch def
  currx curry TotalLevels ThisArray LegendLineItem
  /curry curry 4 mm sub def
 }forall
 %
 grestore
}bind def
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% LegendLineItem: Prints the keys to each categorical level of an icon variable
% for the drawing's icon display legend
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/LegendLineItem {
 /ThisArray exch def
 /TotalLevels exch def
 /cy exch def
 /cx exch def

 ThisArray aload pop
 /BluC exch def
 /GrnC exch def
 /RedC exch def
 /GrayLevel exch def
 /ValueLabel exch def
 /IconLabel exch def
 /CurrentLevel exch def
 gsave
 IconFont IconFontSize scalefont setfont
 newpath
 cx 3 mm sub cy 1.5 mm add moveto
 0 -3 mm rlineto
 6 mm 0 rlineto
 0 3 mm rlineto
 closepath
 GrayLevel RedC GrnC BluC FillRegion
 0.5 setlinewidth
 stroke
 cx IconLabel stringwidth pop 2 div sub cy IconFontSize 3 div sub moveto
 GrayLevel IconLabel ShowRegionText
 cx ValueLabel stringwidth pop 2 div sub 1.5 cm add cy IconFontSize 3 div sub moveto
 ValueLabel show
 grestore
}bind def
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% CircleHighlight: Prints a circular region in color
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/CircleHighlight {
 /Ycenter exch def
 /Xcenter exch def
 gsave
  newpath
  Xcenter Ycenter IconRadius 2 mul 0 360 arc
  gsave
   LightBlue
   fill
  grestore
  Blue
  stroke
 grestore
} bind def


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% *** END OF PROCEDURES ***
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%


